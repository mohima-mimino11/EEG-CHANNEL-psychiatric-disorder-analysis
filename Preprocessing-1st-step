(n_components=20, random_state=97)\n        ica.fit(raw)\n        print(\"ICA fitted.\")\n        raw = ica.apply(raw)\n        print(\"ICA applied.\")\n\n        # Detect events\n        events = mne.find_events(raw, stim_channel='STI 014', min_duration=0.01, shortest_event=2, verbose=True)\n        print(f\"Events found: {events.shape[0]}\")\n\n        if events.shape[0] == 0:\n            print(\"No events found. Skipping this file.\")\n            return None\n\n        # Define event ID - Placeholder, update with actual event IDs\n        event_id = {'Stimulus': 1}  # Placeholder event ID\n\n        # Define rejection criteria\n        reject_criteria = dict(eeg=250e-6)  # 250 µV threshold for EEG\n\n        # Create epochs\n        epochs = mne.Epochs(\n            raw, events=events, event_id=event_id,\n            tmin=-0.2, tmax=0.8, preload=True,\n            reject=reject_criteria\n        )\n        print(f\"Epochs created. Remaining epochs: {len(epochs)}\")\n\n        if len(epochs) == 0:\n            print(\"Warning: All epochs were dropped! Adjusting rejection criteria.\")\n            # Re-attempt epoch creation without rejection criteria for inspection\n            epochs = mne.Epochs(\n                raw, events=events, event_id=event_id,\n                tmin=-0.2, tmax=0.8, preload=True,\n                reject=None\n            )\n            print(f\"Re-attempted Epochs creation without rejection criteria: {len(epochs)}\")\n\n        # Apply baseline correction\n        epochs.apply_baseline((None, 0))\n        print(\"Baseline correction applied.\")\n\n        # Ensure unique output path for each file\n        output_file_name = os.path.basename(file_path).replace('.raw', '-epo.fif')\n        output_path = os.path.join(output_dir, output_file_name)\n        \n        # Save the preprocessed epochs\n        epochs.save(output_path, overwrite=True)\n        print(f\"Saved preprocessed data to {output_path}\")\n\n    except Exception as e:\n    