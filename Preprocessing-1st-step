ctory19/15_mfccs.npy\nSaved selected features to /kaggle/working/preprocessed_audio_output_directory19/18_mfccs.npy\nSaved selected features to /kaggle/working/preprocessed_audio_output_directory19/01_mfccs.npy\nFeatures saved in /kaggle/working/preprocessed_audio_output_directory19.\n","output_type":"stream"}]},{"cell_type":"code","source":"import os\nimport numpy as np\nimport soundfile as sf\nimport librosa\nimport opensmile\nfrom sklearn.feature_selection import SelectKBest, mutual_info_classif\n\n# Function for pre-emphasis\ndef pre_emphasis(signal, pre_emphasis_coeff=0.97):\n    return np.append(signal[0], signal[1:] - pre_emphasis_coeff * signal[:-1])\n\n# Function to frame the signal\ndef framing(signal, frame_size, frame_stride, sample_rate):\n    frame_length = int(frame_size * sample_rate)\n    frame_step = int(frame_stride * sample_rate)\n    signal_length = len(signal)\n    num_frames = int(np.ceil(float(np.abs(signal_length - frame_length)) / frame_step))\n\n    pad_signal_length = num_frames * frame_step + frame_length\n    z = np.zeros((pad_signal_length - signal_length))\n    pad_signal = np.append(signal, z)\n\n    indices = np.tile(np.arange(0, frame_length), (num_frames, 1)) + \\\n              np.tile(np.arange(0, num_frames * frame_step, frame_step), (frame_length, 1)).T\n    frames = pad_signal[indices.astype(np.int32, copy=False)]\n    \n    return frames\n\n# Function to apply Hamming window\ndef windowing(frames):\n    return frames * np.hamming(frames.shape[1])\n\n# Function to extract MFCC features\ndef extract_mfcc(signal, sample_rate, n_mfcc=13):\n    return librosa.feature.mfcc(y=signal, sr=sample_rate, n_mfcc=n_mfcc)\n\n# Function to use OpenSMILE for feature extraction\ndef extract_opensmile_features(signal, sample_rate):\n    smile = opensmile.Smile(\n        feature_set=opensmile.FeatureSet.ComParE_2016,\n        feature_level=opensmile.FeatureLevel.Functionals\n    )\n    return smile.process_signal(signal, sample_rate)\n\n# Function to preprocess and extract features from a single .wav file\ndef preprocess_and_extract_features(file_path):\n    try:\n        # Load audio file\n        y, sr = sf.read(file_path)\n        print(f\"Loaded {file_path} with sampling rate {sr}, dtype {y.dtype}\")\n        \n        # Pre-emphasis\n        y_preemphasized = pre_emphasis(y)\n        print(\"Pre-emphasis applied.\")\n        \n        # Framing and windowing\n        frame_size = 0.025  # 25 ms\n        frame_stride = 0.01  # 10 ms\n        frames = framing(y_preemphasized, frame_size, frame_stride, sr)\n        frames_windowed = windowing(frames)\n        print(\"Windowing and framing applied.\")\n        \n        # Extract MFCC features\n        mfcc_features = extract_mfcc(y_preemphasized, sr)\n        print(f\"MFCC features extracted with shape {mfcc_features.shape}.\")\n        \n        # Extract OpenSMILE features\n        opensmile_features = extract_opensmile_features(y, sr).to_numpy().flatten()\n        print(f\"OpenSMILE features extracted with shape {opensmile_features.shape}.\")\n        \n        # Combine features\n        combined_features = np.hstack([mfcc_features.flatten(), opensmile_features])\n        print(f\"Combined features extracted with shape {combined_features.shape}.\")\n        \n        return combined_features\n    except Exception as e:\n        print(f\"Error processing {file_path}: {e}\")\n        return None\n\n# Directory containing folders with .wav files\ninput_dir = '/kaggle/input/modma-dataset/audio_lanzhou_2015/audio_lanzhou_2015/02020021'\noutput_dir = '/kaggle/working/preprocessed_audio_output_directory21'\nos.makedirs(output_dir, exist_ok=True)\n\n# Collect and process features\nall_features = []\nfile_names = []\nfor file_name in os.listdir(input_dir):\n    if file_name.endswith('.wav'):\n        file_path = os.path.join(input_dir, file_name)\n        print(f\"Processing file: {file_path}\")\n        features = preprocess_and_extract_features(file_path)\n        if features is not None:\n            all_features.append(features)\n            file_names.append(file_name)\n\n# Determine the maximum feature vector length\nmax_length = max(len(features) for features in all_features)\nprint(f\"Maximum feature length: {max_length}\")\n\n# Pad/truncate features to have the same length\ndef pad_features(features, max_length):\n    if len(features) < max_length:\n        return np.pad(features, (0, max_length - len(features)), 'constant')\n    else:\n        return features[:max_length]\n\nall_features_padded = np.array([pad_features(features, max_length) for features in all_features])\n\n# Simulated labels for demonstration purposes\n# In a real scenario, these should come from your dataset\nlabels = np.random.randint(0, 2, size=(all_features_padded.shape[0],))\n\n# Apply feature selection\ndef feature_selection(X, y, num_features=100):\n    selector = SelectKBest(score_func=mutual_info_classif, k=num_features)\n    X_selected = selector.fit_transform(X, y)\n    print(f\"Selected {num_features} features.\")\n    return X_selected, selector.get_support(indices=True)\n\nX_selected, selected_indices = feature_selection(all_features_padded, labels)\nprint(f\"Selected feature indices: {selected_indices}\")\n\n# Save selected features for each file\nfor i, file_name in enumerate(file_names):\n    selected_features = X_selected[i]\n    output_path = os.path.join(output_dir, file_name.replace('.wav', '_mfccs.npy'))\n    np.save(output_path, selected_features)\n    print(f\"Saved selected features to {output_path}\")\n\nprint(f\"Features saved in {output_dir}.\")\n","metadata":{"execution":{"iopub.status.busy":"2024-06-22T16:21:01.401801Z","iopub.execute_input":"2024-06-22T16:21:01.402135Z","iopub.status.idle":"2024-06-22T16:23:36.222852Z","shell.execute_reply.started":"2024-06-22T16:21:01.402107Z","shell.execute_reply":"2024-06-22T16:23:36.221952Z"},"trusted":true},"execution_count":42,"outputs":[{"name":"stdout","text":"Processin